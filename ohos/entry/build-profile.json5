
{
  "apiType": 'stageMode',
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "",
      "abiFilters": ["arm64-v8a"]  //, "x86_64"
    },
    "nativeLib": {
      "filter": {
        "excludes": ["**/x86_64/**"]
      }
    },
    "resOptions": {
      "ignoreResourcePattern": ["**/jdk-x86_64.*"]
    }
  },
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS"
    },
    {
      "name": "ohosTest",
    }
  ]
}
